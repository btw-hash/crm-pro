# -- Persistence layer --------------------------------------------
# memory   -- in-memory (default; data resets on restart)
# postgres -- PostgreSQL via Prisma (requires DATABASE_URL + running DB)
PERSISTENCE_MODE=memory
# Connection string. Only needed when PERSISTENCE_MODE=postgres.
# Local docker-compose default: postgresql://crmpro:crmpro@localhost:5432/crmpro?schema=public
DATABASE_URL=postgresql://crmpro:crmpro@localhost:5432/crmpro?schema=public
# Variables consumed by the docker-compose db service:
POSTGRES_USER=crmpro
POSTGRES_PASSWORD=crmpro
POSTGRES_DB=crmpro

# -- ERP integration ----------------------------------------------
# stub  -- run on seed data (default; no real ERP needed)
# odata -- real OData/HTTP integration (adapter ready; also works against
#          the local mock: `npm run mock-erp`, see docker-compose.demo.yml)
ERP_MODE=stub
ERP_BASE_URL=
ERP_USERNAME=
ERP_PASSWORD=
# Enables the "Open in ERP" button/iframe when set (e.g. /erp).
ERP_UI_URL=

# -- AI gateway ---------------------------------------------------
# stub -- deterministic stub (default; no network)
# live -- real LLM behind the LlmProvider abstraction (requires AI_API_KEY)
AI_MODE=stub
# anthropic -- Claude; openai -- OpenAI-compatible chat completions
AI_PROVIDER=anthropic
# Provider API key. NEVER commit a real key -- local .env / secrets only.
AI_API_KEY=
# Optional: model override (anthropic -> claude-opus-4-8; openai -> gpt-4o) and base URL.
AI_MODEL=
AI_BASE_URL=
# Data residency guard: global LLMs are blocked for raw PII in production.
# Allow only for synthetic/anonymized data:
ALLOW_GLOBAL_LLM=

# -- Assistant web search -----------------------------------------
# stub -- deterministic stub (default); live -- real provider.
# Only the external question is sent to the search API; never the CRM snapshot.
WEB_SEARCH_MODE=stub
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# -- Auth ----------------------------------------------------------
# Login is real username+password (session in an httpOnly cookie); role comes from the user.
# AUTH_OPTIONAL=true (dev): without a session, act as the demo head-of-sales so you
# don't hit the login wall. Ignored in production -- login is mandatory there.
AUTH_OPTIONAL=true

# -- LLM token usage tracking --------------------------------------
# Server-side journal of actual usage per LLM call (input/output/cached tokens +
# feature/model/time). Only numbers and labels are stored -- never request/response bodies.
# on (default) -- wrap providers with the tracking decorator; off -- zero overhead.
USAGE_TRACKING=on
# Journal retention window, days. memory: daily-aggregate window; postgres: raw retention.
USAGE_RETENTION_DAYS=90
# Capacity of the in-memory detail ring buffer (fixed size; anti-OOM on small demo VMs).
USAGE_MEMORY_MAX_ROWS=1000
